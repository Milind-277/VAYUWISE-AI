# ==============================================================================
# VAYUWISE AI - Backend Environment Configuration Example
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Google Gemini API Key (Required for AI Companion & Action Plan Generator)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Name
# Recommended stable models: gemini-3.8-flash, gemini-3.6-flash
GEMINI_MODEL=gemini-3.8-flash

# OpenAQ API Key (Optional v3 API key, public tier available)
# https://openaq.org/
OPENAQ_API_KEY=

# Data.gov.in / CPCB API Key (Optional - application provides verified model fallbacks)
DATA_GOV_IN_API_KEY=

# Frontend URL for CORS in production
CLIENT_URL=http://localhost:5173
